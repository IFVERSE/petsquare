{
  "name": "petsquare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:admin": "node scripts/seed-super-admin.mjs",
    "scrape": "node scraper/run.js",
    "scrape:dry": "node scraper/run.js --dry-run",
    "scrape:smoke": "node scraper/run.js --dry-run --countries=DE --limit=1",
    "scrape:test": "node scraper/__tests__/run-tests.mjs",
    "scrape:osm:test": "node --test scraper/__tests__/osm.test.mjs",
    "scrape:enrichment:test": "node --test scraper/__tests__/enrichment.test.mjs",
    "test:discovery:browser": "node tests/browser/discovery-ui.mjs",
    "test:products": "node --test tests/products/*.test.ts",
    "test:products:browser": "node tests/browser/product-finder.mjs",
    "test:guide": "node --test tests/support-guide.test.ts",
    "test:guide:browser": "node tests/browser/support-guide.mjs",
    "test:responsive": "node tests/browser/responsive-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/leaflet": "^1.9.22",
    "apify-client": "^2.25.0",
    "cheerio": "^1.2.0",
    "framer-motion": "^13.1.1",
    "groq-sdk": "^1.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "p-limit": "^7.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
