# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact details, included in the frontend at build time.
NEXT_PUBLIC_SUPPORT_WHATSAPP=436781288256
NEXT_PUBLIC_SUPPORT_URL=

# Optional AI vendor search / signed-in assistant.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional scheduled product ingestion. Keep the cron endpoint protected.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_INPUT_JSON=
APIFY_MAX_ITEMS=100
CRON_SECRET=

# Optional translation service.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Only needed when running seed:admin.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
